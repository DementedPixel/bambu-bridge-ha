#!/usr/bin/with-contenv bashio

bashio::log.info "Starting Bambu Dashboard (ingress)..."

# ---------------------------------------------------------------------------
# MQTT broker discovery via Supervisor API (same broker as the bridge)
# ---------------------------------------------------------------------------
if bashio::services.available "mqtt"; then
    MQTT_HOST=$(bashio::services mqtt "host")
    MQTT_PORT=$(bashio::services mqtt "port")
    MQTT_USER=$(bashio::services mqtt "username")
    MQTT_PASS=$(bashio::services mqtt "password")
    MQTT_SSL=$(bashio::services mqtt "ssl")

    export MQTT_BROKER_HOST="${MQTT_HOST}"
    export MQTT_BROKER_PORT="${MQTT_PORT}"
    export MQTT_BROKER_USER="${MQTT_USER}"
    export MQTT_BROKER_PASS="${MQTT_PASS}"

    if bashio::var.true "${MQTT_SSL}"; then
        export MQTT_BROKER_PROTOCOL="mqtts"
    else
        export MQTT_BROKER_PROTOCOL="mqtt"
    fi
else
    bashio::log.warning \
        "No MQTT service available — dashboard will start without live status."
fi

# ---------------------------------------------------------------------------
# Use same printers config generated by the bridge service
# ---------------------------------------------------------------------------
export PRINTERS_CONFIG="/data/printers.json"
export BACKEND_PORT=3001

# ---------------------------------------------------------------------------
# Wait for the bridge to generate printers.json before starting
# ---------------------------------------------------------------------------
WAIT=0
while [ ! -f /data/printers.json ] && [ $WAIT -lt 30 ]; do
    sleep 1
    WAIT=$((WAIT + 1))
done

if [ ! -f /data/printers.json ]; then
    bashio::log.fatal "printers.json not found after 30s — bridge may not be running."
    exit 1
fi

bashio::log.info "Dashboard listening on port ${BACKEND_PORT} (ingress)"

# ---------------------------------------------------------------------------
# Launch the dashboard server
# ---------------------------------------------------------------------------
cd /usr/bin
exec npx tsx server/index.ts
